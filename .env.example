APP_NAME=OutraqHQ
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://outraqhq.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"

# ── Billing (Razorpay, INR) ── prices live in config/plans.php
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Set to 0 if the business is not GST-registered
BILLING_GST_PERCENT=18
# Optional: max refunds an organization can ever get (blank = no limit)
BILLING_REFUND_LIMIT=
# Printed on receipts; receipts become "Tax Invoice" once a GSTIN is set
BILLING_SELLER_NAME=OutraqHQ
BILLING_SELLER_ADDRESS=
BILLING_SELLER_GSTIN=
BILLING_SAC_CODE=
BILLING_SELLER_EMAIL=

# ── Outy (AI assistant, OpenAI tool calling) ── see config/outy.php
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OUTY_DAILY_LIMIT_FREE=50
OUTY_DAILY_LIMIT_PRO=50
OUTY_DAILY_LIMIT_ENTERPRISE=50
